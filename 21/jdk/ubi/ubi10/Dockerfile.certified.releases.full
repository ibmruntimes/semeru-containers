FROM registry.access.redhat.com/ubi10/ubi:latest AS zlib-builder

# The distro spec has BuildRequires on cmake(GTest) and libabigail, which are not in the
# UBI10 repositories, so "dnf builddep" cannot be used. The tools the spec needs are
# installed explicitly, and rpmbuild is run with --nodeps and --nocheck (%check needs
# libabigail). gtest is turned off further down.
RUN dnf install -y \
        gcc gcc-c++ make cmake cmake-rpm-macros \
        rpm-build redhat-rpm-config \
        dnf-plugins-core \
        patch \
    && dnf clean all

# Enable source repos and fetch the zlib-ng SRPM
RUN dnf config-manager --enable '*source*' 2>/dev/null || true && \
    dnf download --source zlib-ng -y --destdir /tmp && \
    rpm -ivh /tmp/zlib-ng-*.src.rpm --define "_topdir /build/rpmbuild" && \
    rm -f /tmp/zlib-ng-*.src.rpm

# Prepare source tree via %prep (applies the distro's own patches)
RUN rpmbuild -bp --nodeps \
        --define "_topdir /build/rpmbuild" \
        /build/rpmbuild/SPECS/zlib-ng.spec

# gtest is not available in UBI10; do not build the gtest tests.
RUN sed -i 's/^%global cmake_param .*-DWITH_RVV=OFF$/& -DWITH_GTEST=OFF/' /build/rpmbuild/SPECS/zlib-ng.spec && \
    grep -q -- '-DWITH_GTEST=OFF' /build/rpmbuild/SPECS/zlib-ng.spec

# Copy and apply custom patch (backport of https://github.com/zlib-ng/zlib-ng/pull/2472)
COPY zlib-ng-dfltcc-env.patch /tmp/zlib-ng-dfltcc-env.patch
RUN CONFIGURE=$(find /build/rpmbuild/BUILD -maxdepth 3 -path '*/zlib-ng-*' -name configure | head -1) && \
    test -n "${CONFIGURE}" && \
    SRC_DIR=$(dirname "${CONFIGURE}") && \
    patch -d "${SRC_DIR}" -p1 < /tmp/zlib-ng-dfltcc-env.patch && \
    rm -f /tmp/zlib-ng-dfltcc-env.patch

# Compile, stage, and package RPMs
RUN rpmbuild -bc --short-circuit --nodeps \
        --define "_topdir /build/rpmbuild" \
        --nocheck \
        /build/rpmbuild/SPECS/zlib-ng.spec && \
    rm -rf /build/rpmbuild/BUILDROOT && \
    rpmbuild -bi --short-circuit --nodeps \
        --define "_topdir /build/rpmbuild" \
        --nocheck \
        /build/rpmbuild/SPECS/zlib-ng.spec && \
    rpmbuild -bb --short-circuit --nodeps \
        --define "_topdir /build/rpmbuild" \
        --nocheck \
        /build/rpmbuild/SPECS/zlib-ng.spec

FROM registry.access.redhat.com/ubi10/ubi:latest AS zlib-extractor

RUN dnf install -y cpio && dnf clean all

# Unpack only the zlib-compatible runtime library (libz.so.1), not the -devel/-static
# packages, so the patched library stays isolated from the system zlib-ng.
RUN mkdir -p /opt/zlib-ng
COPY --from=zlib-builder /build/rpmbuild/RPMS /tmp/rpms
RUN cd /opt/zlib-ng && \
    for rpmfile in $(find /tmp/rpms -name 'zlib-ng-compat-[0-9]*.rpm'); do \
        echo "Extracting $rpmfile to /opt/zlib-ng..."; \
        rpm2cpio "$rpmfile" | cpio -idmv; \
    done && \
    test -e /opt/zlib-ng/usr/lib64/libz.so.1 && \
    rm -rf /tmp/rpms

# Download standalone patchelf binary
RUN set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
        amd64|x86_64) PATCHELF_ARCH="x86_64" ;; \
        aarch64|arm64) PATCHELF_ARCH="aarch64" ;; \
        ppc64el|ppc64le) PATCHELF_ARCH="ppc64le" ;; \
        s390x) PATCHELF_ARCH="s390x" ;; \
        *) echo "Unsupported arch for patchelf: ${ARCH}"; exit 1 ;; \
    esac; \
    curl -LfsSo /tmp/patchelf.tar.gz "https://github.com/NixOS/patchelf/releases/download/0.18.0/patchelf-0.18.0-${PATCHELF_ARCH}.tar.gz"; \
    mkdir -p /opt/patchelf; \
    tar --no-same-owner --no-same-permissions -xf /tmp/patchelf.tar.gz -C /opt/patchelf; \
    rm -f /tmp/patchelf.tar.gz

FROM registry.access.redhat.com/ubi10/ubi:latest AS base-image

ENV LANG='en_US.UTF-8' LANGUAGE='en_US:en' LC_ALL='en_US.UTF-8'

RUN dnf install -y \
    # CRIU dependencies
        iptables-libs jansson libibverbs libmnl libnet libnftnl libpcap nftables protobuf-c \
    # Semeru dependencies
        tzdata openssl ca-certificates fontconfig glibc-langpack-en gzip tar \
    && dnf update -y && dnf clean all;

LABEL name="IBM Semeru Runtime Certified Edition" \
      vendor="International Business Machines Corporation" \
      version="21.0.13.0" \
      release="21" \
      maintainer="jayasg12@in.ibm.com" \
      run="docker run --rm -ti <image_name:tag> /bin/bash" \
      summary="IBM Semeru Runtime Certified Docker Image for OpenJDK with openj9 and ubi" \
      description="For more information on this image please see https://github.com/ibmruntimes/semeru-containers/blob/master/README.md"

# Install CRIU
RUN --mount=type=secret,id=criu_secrets source /run/secrets/criu_secrets; \
    set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
        amd64|x86_64) \
          CRIU_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/x64_linux/ubi10/criu.tar.gz'; \
          CRIU_SHA_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/x64_linux/ubi10/criu.tar.gz.sha256.txt'; \
          ;; \
        ppc64el|ppc64le) \
          CRIU_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/ppc64le_linux/ubi10/criu.tar.gz'; \
          CRIU_SHA_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/ppc64le_linux/ubi10/criu.tar.gz.sha256.txt'; \
          ;; \
        s390x) \
          CRIU_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/s390x_linux/ubi10/criu.tar.gz'; \
          CRIU_SHA_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/s390x_linux/ubi10/criu.tar.gz.sha256.txt'; \
          ;; \
        aarch64) \
          CRIU_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/aarch64_linux/ubi10/criu.tar.gz'; \
          CRIU_SHA_URL='https://na.artifactory.swg-devops.com/artifactory/hyc-rt-java-delivery-generic-local/IBM/java/criu_build/148/aarch64_linux/ubi10/criu.tar.gz.sha256.txt'; \
          ;; \
        *) \
          echo "Unsupported arch: ${ARCH}"; \
          exit 1; \
          ;; \
    esac; \
    cd /tmp; \
    curl -H "${CRIU_AUTH_HEADER}" -LfsSo criu.tar.gz ${CRIU_URL}; \
    curl -H "${CRIU_AUTH_HEADER}" -LfsSo criu.tar.gz.sha256.txt ${CRIU_SHA_URL}; \
    sha256sum -c criu.tar.gz.sha256.txt; \
    tar -xzf criu.tar.gz --strip-components=1; \
    cp -R usr/local /usr; \
    echo /usr/local/lib64 > /etc/ld.so.conf.d/criu.conf; \
    ldconfig; \
    setcap cap_checkpoint_restore,cap_sys_ptrace,cap_setpcap=eip /usr/local/sbin/criu; \
    mkdir -p /opt/criu; \
    cp /usr/local/sbin/criu /opt/criu/criu; \
    setcap cap_checkpoint_restore,cap_setpcap=eip /opt/criu/criu; \
    rm -fr criu criu.tar.gz;

ENV PATH="/usr/local/sbin:$PATH"

ENV JAVA_VERSION 21.0.13.0

RUN --mount=type=secret,id=criu_secrets source /run/secrets/criu_secrets; \
    set -eux; \
    ARCH="$(uname -m)"; \
    case "${ARCH}" in \
       aarch64|arm64) \
         ESUM='58b3473543dcc3cd960d757d73b2ee690a8646d2bb99f3d97227bfca85432c3d'; \
         BINARY_URL='https://github.com/ibmruntimes/semeru21-certified-binaries/releases/download/jdk-21.0.13.0/ibm-semeru-certified-jdk_aarch64_linux_21.0.13.0.tar.gz'; \
         ;; \
       amd64|x86_64) \
         ESUM='b0045ea65b3b95197e8fd9a70a52383ffcb7f7d5c4cf8c9267896f8fd97120d2'; \
         BINARY_URL='https://github.com/ibmruntimes/semeru21-certified-binaries/releases/download/jdk-21.0.13.0/ibm-semeru-certified-jdk_x64_linux_21.0.13.0.tar.gz'; \
         ;; \
       ppc64el|ppc64le) \
         ESUM='65008a3a0de0ed7c82c9004f99ed8327b4c27675511922bc6308fcd5546f5d8c'; \
         BINARY_URL='https://github.com/ibmruntimes/semeru21-certified-binaries/releases/download/jdk-21.0.13.0/ibm-semeru-certified-jdk_ppc64le_linux_21.0.13.0.tar.gz'; \
         ;; \
       s390x) \
         ESUM='80832826fbc1d0fa81a7531ae81081e86d5b69db9ead4e5e0f0c2bb54b90d8b6'; \
         BINARY_URL='https://github.com/ibmruntimes/semeru21-certified-binaries/releases/download/jdk-21.0.13.0/ibm-semeru-certified-jdk_s390x_linux_21.0.13.0.tar.gz'; \
         ;; \
       *) \
         echo "Unsupported arch: ${ARCH}"; \
         exit 1; \
         ;; \
    esac; \
    curl -LfsSo /tmp/openjdk.tar.gz ${BINARY_URL}; \
    echo "${ESUM} */tmp/openjdk.tar.gz" | sha256sum -c -; \
    mkdir -p /opt/ibm/; \
    cd /opt/ibm/; \
    tar -xf /tmp/openjdk.tar.gz ; \
    mkdir -p /licenses; \
    mv /opt/ibm/jdk-21* /opt/ibm/java; \
    cp /opt/ibm/java/legal/java.base/license/license_en.txt /licenses; \
    rm -rf /tmp/openjdk.tar.gz;

# Copy patched zlib-ng and patchelf
COPY --from=zlib-extractor /opt/zlib-ng /opt/zlib-ng
COPY --from=zlib-extractor /opt/patchelf/bin/patchelf /usr/local/bin/patchelf

# Point every Semeru ELF file that depends on libz.so.1 at /opt/zlib-ng.
# /opt/zlib-ng/usr/lib64 is put first in DT_RUNPATH; any existing entries are kept.
RUN set -eux; \
    patched=0; \
    for f in $(find /opt/ibm/java -type f); do \
        needed="$(patchelf --print-needed "$f" 2>/dev/null)" || continue; \
        echo "${needed}" | grep -qx 'libz.so.1' || continue; \
        cur="$(patchelf --print-rpath "$f")"; \
        patchelf --set-rpath "/opt/zlib-ng/usr/lib64${cur:+:${cur}}" "$f"; \
        ldd "$f" | grep -q '/opt/zlib-ng/usr/lib64/libz.so.1'; \
        echo "patched: $f (rpath: $(patchelf --print-rpath "$f"))"; \
        patched=$((patched + 1)); \
    done; \
    [ "${patched}" -gt 0 ]; \
    rm -f /usr/local/bin/patchelf;

ENV JAVA_HOME=/opt/ibm/java \
    PATH="/opt/ibm/java/bin:$PATH"
ENV JAVA_TOOL_OPTIONS="-XX:+IgnoreUnrecognizedVMOptions -XX:+PortableSharedCache -XX:+IdleTuningGcOnIdle -Xshareclasses:name=openj9_system_scc,cacheDir=/opt/java/.scc,readonly,nonFatal"

# Create OpenJ9 SharedClassCache (SCC) for bootclasses to improve the java startup.
# Downloads and runs tomcat to generate SCC for bootclasses at /opt/java/.scc/openj9_system_scc
# Does a dry-run and calculates the optimal cache size and recreates the cache with the appropriate size.
# With SCC, OpenJ9 startup is improved ~50% with an increase in image size of ~14MB
# Application classes can be create a separate cache layer with this as the base for further startup improvement

RUN set -eux; \
    unset OPENJ9_JAVA_OPTIONS; \
    SCC_SIZE="50m"; \
    DOWNLOAD_PATH_TOMCAT=/tmp/tomcat; \
    INSTALL_PATH_TOMCAT=/opt/tomcat-home; \
    export CATALINA_PID=/opt/tomcat-home/tomcat.pid; \
    TOMCAT_CHECKSUM="16494dd4745f808d3c506807b5275521fd71044d976f441d18eeeab0f5a38bc1b5344ca395292f6f26eb7612cd8c8e746d01ccdfb29893d394052d9f4b1f4c11"; \
    TOMCAT_VERSION="9.0.121"; \
    TOMCAT_FILENAME="apache-tomcat-${TOMCAT_VERSION}.tar.gz"; \
    SUCCESS=; \
    \
    mkdir -p "${DOWNLOAD_PATH_TOMCAT}" "${INSTALL_PATH_TOMCAT}"; \
    for baseUrl in \
        https://dlcdn.apache.org/tomcat/tomcat-9/v${TOMCAT_VERSION}/bin \
        https://archive.apache.org/dist/tomcat/tomcat-9/v${TOMCAT_VERSION}/bin \
    ; do \
        if curl -LfsSo "${DOWNLOAD_PATH_TOMCAT}"/tomcat.tar.gz "${baseUrl}/${TOMCAT_FILENAME}" && [ -s "${DOWNLOAD_PATH_TOMCAT}"/tomcat.tar.gz ]; then \
            SUCCESS=1; \
            break; \
        fi; \
    done; \
    [ -n "$SUCCESS" ]; \
    echo "${TOMCAT_CHECKSUM}  ${DOWNLOAD_PATH_TOMCAT}/tomcat.tar.gz" | sha512sum -c -; \
    tar -xf "${DOWNLOAD_PATH_TOMCAT}"/tomcat.tar.gz -C "${INSTALL_PATH_TOMCAT}" --strip-components=1; \
    rm -rf "${DOWNLOAD_PATH_TOMCAT}"; \
    \
    java -Xshareclasses:name=dry_run_scc,cacheDir=/opt/java/.scc,bootClassesOnly,nonFatal,createLayer -Xscmx$SCC_SIZE -version; \
    export OPENJ9_JAVA_OPTIONS="-XX:+IProfileDuringStartupPhase -Xshareclasses:name=dry_run_scc,cacheDir=/opt/java/.scc,bootClassesOnly,nonFatal"; \
    "${INSTALL_PATH_TOMCAT}"/bin/startup.sh; \
    sleep 20; \
    "${INSTALL_PATH_TOMCAT}"/bin/shutdown.sh -force; \
    sleep 15; \
    FULL=$( (java -Xshareclasses:name=dry_run_scc,cacheDir=/opt/java/.scc,printallStats 2>&1 || true) | awk '/^Cache is [0-9.]*% .*full/ {print substr($3, 1, length($3)-1)}'); \
    DST_CACHE=$(java -Xshareclasses:name=dry_run_scc,cacheDir=/opt/java/.scc,destroy 2>&1 || true); \
    SCC_SIZE=$(echo $SCC_SIZE | sed 's/.$//'); \
    SCC_SIZE=$(awk "BEGIN {print int($SCC_SIZE * $FULL / 100.0)}"); \
    [ "${SCC_SIZE}" -eq 0 ] && SCC_SIZE=1; \
    SCC_SIZE="${SCC_SIZE}m"; \
    java -Xshareclasses:name=openj9_system_scc,cacheDir=/opt/java/.scc,bootClassesOnly,nonFatal,createLayer -Xscmx$SCC_SIZE -version; \
    unset OPENJ9_JAVA_OPTIONS; \
    \
    export OPENJ9_JAVA_OPTIONS="-XX:+IProfileDuringStartupPhase -Xshareclasses:name=openj9_system_scc,cacheDir=/opt/java/.scc,bootClassesOnly,nonFatal"; \
    "${INSTALL_PATH_TOMCAT}"/bin/startup.sh; \
    sleep 20; \
    "${INSTALL_PATH_TOMCAT}"/bin/shutdown.sh -force; \
    sleep 5; \
    FULL=$( (java -Xshareclasses:name=openj9_system_scc,cacheDir=/opt/java/.scc,printallStats 2>&1 || true) | awk '/^Cache is [0-9.]*% .*full/ {print substr($3, 1, length($3)-1)}'); \
    echo "SCC layer is $FULL% full."; \
    rm -rf "${INSTALL_PATH_TOMCAT}"; \
    unset CATALINA_PID; \
    # Create a new SCC layer
    if [ ! -d "/opt/java/.scc" ]; then \
          mkdir /opt/java/.scc; \
    fi; \
    chmod -R 0777 /opt/java/.scc; \
    \
    echo "SCC generation phase completed";

FROM base-image AS instanton-ldconfig

# For InstantOn, generate instanton.ld.so.cache which excludes glibc-hwcaps directories.
# This is done in an intermediate stage to avoid modifying the base image.
# ldconfig output example lines:
#         libcap-ng.so.0 (libc6,64bit) => /lib64/libcap-ng.so.0
#         libc_malloc_debug.so.0 (libc6,64bit, OS ABI: Linux 3.10.0) => /lib64/libc_malloc_debug.so.0
#         libc.so.6 (libc6,64bit, hwcap: "power10", OS ABI: Linux 3.10.0) => /lib64/glibc-hwcaps/power10/libc.so.6
# sed regexp filter should pass any line that looks as follows: ... => /.../glibc-hwcaps/...
RUN glibc_hwcaps_dirs=$(ldconfig --print-cache | sed --regexp-extended --silent 's,^.+[[:space:]]+=>[[:space:]]+(/.+/glibc-hwcaps)/.+$,\1,p' | sort | uniq) \
    && for d in $glibc_hwcaps_dirs; do rm -rf $d; done \
    && ldconfig

FROM base-image

COPY --from=instanton-ldconfig /etc/ld.so.cache /etc/instanton.ld.so.cache

USER 1001
CMD ["jshell"]
