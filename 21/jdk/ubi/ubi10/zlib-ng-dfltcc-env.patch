diff --git a/arch/s390/dfltcc_common.c b/arch/s390/dfltcc_common.c
new file mode 100644
index 00000000..77e005c5
--- /dev/null
+++ b/arch/s390/dfltcc_common.c
@@ -0,0 +1,34 @@
+/* dfltcc_common.c - Runtime control for IBM Z DFLTCC acceleration.
+ * For conditions of distribution and use, see copyright notice in zlib.h
+ */
+
+#ifdef HAVE_SECURE_GETENV
+#  ifndef _GNU_SOURCE
+#    define _GNU_SOURCE
+#  endif
+#endif
+
+#include "zbuild.h"
+#include "dfltcc_common.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+int Z_INTERNAL PREFIX(dfltcc_enabled) = DFLTCC_ENABLED;
+
+#ifdef DFLTCC_ENV
+static void __attribute__((constructor)) dfltcc_init_env(void) {
+    const char *value;
+
+#  ifdef HAVE_SECURE_GETENV
+    value = secure_getenv("DFLTCC");
+#  else
+    value = getenv("DFLTCC");
+#  endif
+
+    if (value == NULL)
+        PREFIX(dfltcc_enabled) = DFLTCC_ENABLED;
+    else
+        PREFIX(dfltcc_enabled) = strcmp(value, "0") != 0;
+}
+#endif
\ No newline at end of file
diff --git a/arch/s390/dfltcc_common.h b/arch/s390/dfltcc_common.h
index a6527ab5..9113ff3b 100644
--- a/arch/s390/dfltcc_common.h
+++ b/arch/s390/dfltcc_common.h
@@ -3,6 +3,17 @@
 
 #include "zutil.h"
 
+/*
+  control usage of DFLTCC
+
+  env variable: DFLTCC
+  unset or unreadable: use default (DFLTCC_ENABLED)
+  0: disable DFLTCC
+  1 or any other value: enable DFLTCC
+ */
+extern int Z_INTERNAL PREFIX(dfltcc_enabled);
+#define DFLTCC_ENABLED 1
+
 /*
    Parameter Block for Query Available Functions.
  */
diff --git a/arch/s390/dfltcc_deflate.c b/arch/s390/dfltcc_deflate.c
index 90b4b96e..035c52a5 100644
--- a/arch/s390/dfltcc_deflate.c
+++ b/arch/s390/dfltcc_deflate.c
@@ -37,6 +37,9 @@ static inline int dfltcc_can_deflate_with_params(PREFIX3(streamp) strm, int leve
     deflate_state *state = (deflate_state *)strm->state;
     arch_deflate_state *dfltcc_state = &state->arch;
 
+    if (!PREFIX(dfltcc_enabled))
+        return 0;
+
     /* Unsupported compression settings */
     if ((dfltcc_state->level_mask & (1 << level)) == 0)
         return 0;
diff --git a/arch/s390/dfltcc_inflate.c b/arch/s390/dfltcc_inflate.c
index cc3cb397..5a5c9cd9 100644
--- a/arch/s390/dfltcc_inflate.c
+++ b/arch/s390/dfltcc_inflate.c
@@ -30,6 +30,9 @@ int Z_INTERNAL PREFIX(dfltcc_can_inflate)(PREFIX3(streamp) strm) {
     struct inflate_state *state = (struct inflate_state *)strm->state;
     struct dfltcc_state *dfltcc_state = &state->arch.common;
 
+    if (!PREFIX(dfltcc_enabled))
+        return 0;
+
     /* Unsupported hardware */
     return is_bit_set(dfltcc_state->af.fns, DFLTCC_XPND) && is_bit_set(dfltcc_state->af.fmts, DFLTCC_FMT0);
 }
