     --force-sse2) forcesse2=1; shift ;;
@@ -1420,6 +1423,24 @@ EOF
     fi
 }
 
+check_secure_getenv() {
+    cat > $test.c << EOF
+#include <stdlib.h>
+int main(void) { return secure_getenv("TEST") == 0; }
+EOF
+    printf "Checking for secure_getenv... " | tee -a configure.log
+    if try $CC $CFLAGS -Werror=implicit-function-declaration -o $test $test.c $LDSHAREDLIBC; then
+        HAVE_SECURE_GETENV=1
+        echo "Yes." | tee -a configure.log
+    elif try $CC $CFLAGS -D_GNU_SOURCE -Werror=implicit-function-declaration -o $test $test.c $LDSHAREDLIBC; then
+        HAVE_SECURE_GETENV=1
+        echo "Yes (with _GNU_SOURCE)." | tee -a configure.log
+    else
+        HAVE_SECURE_GETENV=0
+        echo "No." | tee -a configure.log
+    fi
+}
+
 check_sse42_intrinsics() {
     # Check whether compiler supports SSE4.2 intrinsics
     cat > $test.c << EOF
@@ -1875,6 +1896,21 @@ EOF
                 ARCH="${ARCH}+dfltcc-inflate"
             fi
 
+            if test $builddfltccinflate -eq 1 -o $builddfltccdeflate -eq 1; then
+                ARCH_STATIC_OBJS="${ARCH_STATIC_OBJS} dfltcc_common.o"
+                ARCH_SHARED_OBJS="${ARCH_SHARED_OBJS} dfltcc_common.lo"
+                if test $builddfltccenv -eq 1; then
+                    CFLAGS="${CFLAGS} -DDFLTCC_ENV"
+                    SFLAGS="${SFLAGS} -DDFLTCC_ENV"
+                    ARCH="${ARCH}+dfltcc-env"
+                    check_secure_getenv
+                    if test $HAVE_SECURE_GETENV -eq 1; then
+                        CFLAGS="${CFLAGS} -DHAVE_SECURE_GETENV"
+                        SFLAGS="${SFLAGS} -DHAVE_SECURE_GETENV"
+                    fi
+                fi
+            fi
+
             if test $buildcrc32vx -eq 1; then
                 check_vgfma_intrinsics
                 if test $HAVE_VGFMA_INTRIN -eq 1; then
