+                set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
+                set(CMAKE_REQUIRED_FLAGS -Werror=implicit-function-declaration)
+                check_symbol_exists(secure_getenv "stdlib.h" HAVE_SECURE_GETENV)
+                set(CMAKE_REQUIRED_DEFINITIONS)
+                set(CMAKE_REQUIRED_FLAGS)
+                if(HAVE_SECURE_GETENV)
+                    set_property(SOURCE ${ARCHDIR}/dfltcc_common.c APPEND
+                                 PROPERTY COMPILE_DEFINITIONS HAVE_SECURE_GETENV)
+                endif()
+            endif()
+        endif()
         if(WITH_CRC32_VX)
             check_vgfma_intrinsics()
             if(HAVE_VGFMA_INTRIN)
